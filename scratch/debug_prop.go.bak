package main

import (
	"fmt"
	"math"
	"ssis/pkg/orbital"
)

func main() {
	initial := orbital.State{X: 8000.0, Y: 0, Z: 0, VX: 0, VY: 7.0, VZ: 0}
	vInitial := orbital.StateToVector(initial)
	jd := 2461148.322731

	// Propagate forward 1800s
	vMidForward := orbital.PropagateCartesianState(vInitial, 1800, jd)
	
	// Create a "post" state at 3600s
	vPost := orbital.PropagateCartesianState(vMidForward, 1800, jd)
	
	// Propagate "post" backward 1800s
	vMidBackward := orbital.PropagateCartesianState(vPost, -1800, jd)

	fmt.Printf("Forward:  %+v\n", vMidForward)
	fmt.Printf("Backward: %+v\n", vMidBackward)

	dv := 0.0
	for i := 0; i < 6; i++ {
		diff := vMidForward[i] - vMidBackward[i]
		dv += diff * diff
	}
	fmt.Printf("Diff Mag: %f\n", math.Sqrt(dv))
}
